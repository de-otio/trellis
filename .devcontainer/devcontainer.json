// base in dot-work and re-vendor.
{
  "name": "trellis (agent sandbox)",

  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "agent",
  "runServices": ["postgres", "dynamodb", "localstack"],
  "workspaceFolder": "/workspace",

  "containerUser": "root",
  "remoteUser": "node",

  "mounts": [
    "source=${localEnv:HOME}/.config/repo-aegis/engagements.yaml,target=/opt/agent/registry/engagements.yaml,type=bind,readonly"
  ],

  "remoteEnv": { "GH_TOKEN": "${localEnv:AGENT_GH_TOKEN}" },
  "containerEnv": { "AGENT_ALLOW_SERVICES": "postgres:5432,dynamodb:8000,localstack:4566" },

  "postCreateCommand": "npm ci",

  "features": {}
}
