{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Trellis API",
    "version": "0.25.0-alpha.14",
    "description": "Social-network core API. Discovery surfaces, federation management (T3–T8), and entity/social graph endpoints."
  },
  "paths": {
    "/api/v1/users/me/tenants": {
      "get": {
        "summary": "List caller's tenant memberships",
        "operationId": "listMyTenants",
        "tags": [
          "tenants"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/listMyTenantsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "oauth2": [
              "tenant:read"
            ]
          }
        ],
        "x-stability": "beta"
      }
    }
  },
  "components": {
    "schemas": {
      "listMyTenantsResponse": {
        "type": "object",
        "properties": {
          "memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tenantId": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "tenant": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "slug": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "slug",
                    "displayName",
                    "type",
                    "status"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "tenantId",
                "role",
                "tenant"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "memberships"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Third-party client access via the device authorization grant (RFC 8628): POST /oauth2/device_authorization, the user approves at /agents/authorize, the client polls POST /oauth2/token.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/agents/authorize",
            "tokenUrl": "/oauth2/token",
            "scopes": {
              "profile:read": "Read your name, handle and avatar",
              "entities:read": "Read the profiles you can see",
              "entities:write": "Create and update profiles you own",
              "posts:read": "Read posts you can see",
              "posts:write": "Post on your behalf",
              "tenant:read": "Read which space you are in",
              "events:subscribe": "Receive notifications about your data"
            }
          }
        }
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "First-party session bearer token."
      }
    }
  }
}
