{
  "name": "@de-otio/trellis",
  "version": "0.25.0-alpha.14",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/lib/crypto/voting/*": null,
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "src/lambda"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "prepack": "node -e \"require('fs').cpSync('../../prisma','./prisma',{recursive:true})\"",
    "postpack": "node -e \"require('fs').rmSync('./prisma',{recursive:true,force:true})\"",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --config vitest.coverage-ci.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "vitest run --config vitest.integration-ci.config.ts",
    "test:standalone": "vitest run --config vitest.standalone.config.ts",
    "test:graph": "vitest run --config vitest.graph.config.ts",
    "test:graph:failover": "vitest run --config vitest.graph.failover.config.ts",
    "test:schema": "vitest run --config vitest.schema.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:smoke": "E2E_SHARD=smoke vitest run --config vitest.e2e.smoke.config.ts",
    "test:e2e:crud": "E2E_SHARD=crud E2E_USER_COUNT=2 vitest run --config vitest.e2e.crud.config.ts",
    "test:e2e:social": "E2E_SHARD=social E2E_USER_COUNT=2 vitest run --config vitest.e2e.social.config.ts",
    "test:e2e:media": "E2E_SHARD=media E2E_USER_COUNT=1 vitest run --config vitest.e2e.media.config.ts",
    "test:e2e:security": "E2E_SHARD=security E2E_USER_COUNT=1 vitest run --config vitest.e2e.security.config.ts",
    "test:e2e:readonly": "E2E_SHARD=readonly E2E_USER_COUNT=1 vitest run --config vitest.e2e.readonly.config.ts",
    "test:e2e:standalone": "E2E_SHARD=standalone E2E_USER_COUNT=2 vitest run --config vitest.e2e.standalone.config.ts",
    "test:postdeployment": "vitest run --config vitest.postdeployment.config.ts",
    "test:postdeployment:api": "vitest run --config vitest.postdeployment.api.config.ts",
    "test:postdeployment:followers": "vitest run --config vitest.postdeployment.followers.config.ts",
    "lint": "tsc --build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:feature-toggles": "tsx scripts/seed-feature-toggles.ts",
    "seed:platform-categories": "tsx scripts/seed-platform-categories.ts",
    "openapi:snapshot": "tsx scripts/check-openapi-additivity.mjs update",
    "openapi:check": "tsx scripts/check-openapi-additivity.mjs check",
    "api-snapshot:update": "node scripts/update-api-snapshot.mjs",
    "api-snapshot:check": "node scripts/check-api-snapshot.mjs",
    "extension-api:version-check": "node scripts/check-extension-api-version.mjs"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@aws-lambda-powertools/parameters": "^2.35.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1121.0",
    "@aws-sdk/client-cloudwatch": "^3.1121.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1121.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1121.0",
    "@aws-sdk/client-cost-explorer": "^3.1121.0",
    "@aws-sdk/client-dynamodb": "^3.1121.0",
    "@aws-sdk/client-ecs": "^3.1121.0",
    "@aws-sdk/client-kms": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/client-secrets-manager": "^3.1121.0",
    "@aws-sdk/client-ses": "^3.1121.0",
    "@aws-sdk/client-sns": "^3.1121.0",
    "@aws-sdk/client-sqs": "^3.1121.0",
    "@aws-sdk/client-ssm": "^3.1121.0",
    "@aws-sdk/s3-presigned-post": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@de-otio/saas-foundation": "^0.4.3",
    "@de-otio/trellis-extension-api": "^0.9.0",
    "@de-otio/vestibulum": "^0.5.0",
    "@fedify/fedify": "2.3.5",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/adapter-pg": "^7.9.1",
    "cockatiel": "^4.0.0",
    "exifr": "^7.1.3",
    "hono": "^4.13.3",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "undici": "^8.9.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@prisma/client": "^7.10.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1121.0",
    "@de-otio/trellis-extension-testkit": "^0.1.0",
    "@prisma/client": "^7.10.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.9.0",
    "form-data": "^4.0.1",
    "js-yaml": "^5.4.1",
    "mailparser": "^3.9.17",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-otio/trellis.git",
    "directory": "apps/api"
  }
}
