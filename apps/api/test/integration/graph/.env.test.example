# Graph Integration Test — Environment Variables
#
# Copy this file to .env.test.local (git-ignored) and fill in your values.
# NEVER commit real credentials.
#
# Required:
NEO4J_TEST_URI=bolt://localhost:7687
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=your-neo4j-password-here

# Optional (defaults to "test" — do not change to "neo4j"):
NEO4J_TEST_DATABASE=test
