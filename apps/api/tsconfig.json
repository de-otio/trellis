{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // The root config sets noEmit:true to stop a repo-root `tsc` from writing
    // shadow .js next to every source file. THIS package's build must emit —
    // the published tarball ships dist/ — so override it back explicitly
    // (same as apps/worker/tsconfig.build.json does).
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "preserveSymlinks": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"],
  "references": [
    { "path": "../../packages/extension-api/tsconfig.json" }
  ]
}
