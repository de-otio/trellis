{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext for the same reason extension-api uses it: this package is
    // `"type": "module"` and ships an `exports` map, so TypeScript must enforce
    // the mandatory `.js` specifier on relative imports. Under `node`
    // resolution a missing extension compiles here and fails in the consumer.
    "module": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0",
    "outDir": "./lib",
    "rootDir": "./src",
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib", "test"],
  "references": [{ "path": "../extension-api/tsconfig.json" }]
}
