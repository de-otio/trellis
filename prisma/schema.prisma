// Domain reputation tracking
model DomainReputation {
  id          String   @id @default(cuid())
  domain      String   @unique
  reputation  Int      @default(0) // -100 to +100
  status      String   @default("unknown") // unknown, safe, warning, blocked
  lastChecked DateTime @default(now()) @map("last_checked")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  linkChecks LinkCheck[]

  // AR10 prune: dropped [domain] (duplicate of @unique).
  @@index([status])
  @@index([reputation])
  @@map("domain_reputations")
}

// Link check results (for posts/comments)
model LinkCheck {
  id            String    @id @default(cuid())
  // Multi-tenancy — denormalized from the owning post/comment (both are
  // tenant-scoped); required so geo/link rows are directly RLS-able.
  tenantId      String    @map("tenant_id")
  postId        String?   @map("post_id") // Nullable for comments
  commentId     String?   @map("comment_id") // Nullable for posts
  originalUrl   String    @map("original_url")
  normalizedUrl String    @map("normalized_url")
  finalUrl      String?   @map("final_url") // After redirect resolution
  domain        String
  status        String // pending, safe, warning, blocked
  checkType     String    @map("check_type") // immediate, async
  threatIntel   Json?     @map("threat_intel") // Results from external APIs
  createdAt     DateTime  @default(now()) @map("created_at")
  checkedAt     DateTime? @map("checked_at")

  // Relations
  post             Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment          PostComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  domainReputation DomainReputation @relation(fields: [domain], references: [domain])
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([postId])
  @@index([commentId])
  @@index([domain])
  @@index([status])
  @@map("link_checks")
}

// LinkReport was folded into the generalized `Report` model (Surveillance-
// hardening Phase 0, P4): reportType=LINK, resourceType="url", resourceId=url,
// reporterUserId=userId, plus the indexed `domain` column. The link_reports
// table is dropped in the P4 migration.

// ============================================================================
// Surveillance-hardening Phase 0 (doc/02-technical/surveillance-threat-model/)
// ============================================================================

// E1 — Append-only behavioral event log. Preserves the TEMPORAL signal that
// `Relationship.signals` aggregate counters destroy, bounded to a rolling
// retention window. P2 writes the rows (dual-write alongside aggregation);
// Phase 0 ships ZERO read paths — any future read is restricted to the Phase 2
// detection path + moderator surfaces (MODERATOR/SUPER_ADMIN, audited).
//
// Data-minimization invariants (security review blocks on these):
//   - NO free-text/content column — event type + references only. The table
//     must be useless as a content archive.
//   - `expiresAt` is NON-NULLABLE: no schema path to an unbounded behavioral
//     log. P2 sets it to createdAt + retentionDays (config).
//   - `targetId` has no FK (polymorphic; the target may be a deleted user) —
//     so cascade can't reach rows ABOUT a deleted user. P2 adds the explicit
//     deleteMany to user-data-deletion.ts (GDPR Art. 17).
model InteractionEvent {
  id          String @id @default(cuid())
  actorUserId String @map("actor_user_id")

  // Polymorphic target, no FK (matches Relationship's convention). Vocabulary:
  // "user" | "entity" | "post" — the GraphNodeType strings P2 dual-writes from.
  targetType String @map("target_type")
  targetId   String @map("target_id")

  // Interaction vocabulary — exactly InteractionCounts in graph/postgres/
  // scoring.ts: view | react | comment | share | depth_mode | profile_visit |
  // content_creation. A string, not an enum, to track that vocabulary cheaply.
  interactionType String @map("interaction_type")

  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Retention bound — NON-NULLABLE. Append-only: no updatedAt, no update path.
  expiresAt DateTime @map("expires_at")

  actor User @relation("InteractionActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([expiresAt]) // pruning: DELETE WHERE expires_at < now()
  @@map("interaction_events")
}

// E3 — Generalized report model. Folds in LinkReport (P4) and makes Phase 1
// account reporting "add a reportType", not a new subsystem. Queue fields
// (assignee/resolution) exist now but are unused until Phase 1.
//
// Erasure:
//   - `reporterUserId` cascades (a deleted reporter's reports go with them —
//     matches the old LinkReport behavior).
//   - `resourceId` is an OPAQUE string, no FK: an ACCOUNT report's reported
//     user may be deleted. P4 pseudonymizes resourceId on erasure of the
//     reported user (aggregate pattern analysis survives; plaintext ID does
//     not — "pattern analysis" is not an Art. 17(3) exemption).
//   - `assigneeUserId` is a plain string (no FK): a deleted moderator must not
//     cascade-delete the reports they were assigned.
model Report {
  id             String     @id @default(cuid())
  reportType     ReportType @map("report_type")
  resourceType   String     @map("resource_type") // "url" (LINK) | "user" (ACCOUNT)
  resourceId     String     @map("resource_id") // opaque; no FK by design
  reporterUserId String     @map("reporter_user_id")
  reason         String? // free-text; P4 enforces a 1000-char Zod bound at the boundary
  status         String     @default("pending") // pending | reviewed | resolved
  // LINK-report registrable domain (P4 fold-in of LinkReport). Indexed +
  // queried hot by DomainReputationService (auto-block threshold counts by
  // domain). Nullable: ACCOUNT reports have no domain.
  domain         String?
  assigneeUserId String?    @map("assignee_user_id") // Phase 1 moderator queue
  resolvedAt     DateTime?  @map("resolved_at")
  resolution     String? // Phase 1 moderator queue
  createdAt      DateTime   @default(now()) @map("created_at")

  reporter User @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([reportType, status])
  @@index([resourceType, resourceId])
  @@index([reporterUserId])
  @@index([domain])
  @@map("reports")
}

// ============================================================================
// Email Suppression (AWS SES bounce/complaint handling)
// ============================================================================

model EmailSuppression {
  id           String   @id @default(cuid())
  email        String   @unique
  reason       String // "bounce" | "complaint"
  bounceType   String? // "permanent" | "transient" for bounces
  suppressedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // AR10 prune: dropped [email] (duplicate of @unique).
}

// ============================================================================
// Deletion Audit Log (GDPR compliance proof — NOT cascade-deleted)
// ============================================================================

model DeletionAuditLog {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  email        String
  requestedAt  DateTime  @map("requested_at")
  confirmedAt  DateTime? @map("confirmed_at")
  completedAt  DateTime  @default(now()) @map("completed_at")
  itemsDeleted Json      @map("items_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("deletion_audit_logs")
}

// ============================================================================
// Safer Social Design (Plan 003)
// ============================================================================

// Age tiers for age-gated behavior
enum AgeTier {
  CHILD // under 13
  TEEN // 13-17
  ADULT // 18+
}

// Profile visibility levels
enum ProfileVisibility {
  PUBLIC // discoverable in search, visible to all
  CONNECTIONS // visible only to mutual follows
  PRIVATE // visible only to self and guardian
}

// DM access control
enum DmAccess {
  ANYONE // anyone can DM
  CONNECTIONS // only mutual follows
  NOBODY // DMs disabled
}

// Parental link status
enum ParentalLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

// Parental link between guardian and child accounts
model ParentalLink {
  id          String             @id @default(cuid())
  childId     String             @map("child_id")
  guardianId  String             @map("guardian_id")
  status      ParentalLinkStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at")
  confirmedAt DateTime?          @map("confirmed_at")

  child    User @relation("ChildParentalLinks", fields: [childId], references: [id])
  guardian User @relation("GuardianParentalLinks", fields: [guardianId], references: [id])

  @@unique([childId, guardianId])
  @@index([guardianId])
  @@map("parental_links")
}

// Notification types (safe by default — no re-engagement or social proof)
enum NotificationType {
  DIRECT_MESSAGE
  SAFETY_ALERT
  PARENTAL_LINK
  FOLLOW
  SENTIMENT_DIGEST
  SYSTEM
  RELATIONSHIP_CREATED
  RELATIONSHIP_RECIPROCATED
  TIER_CHANGED
  ENTITY_RELATIONSHIP_PROPOSED
  ENTITY_RELATIONSHIP_CONFIRMED
  CONNECTION_CODE_REDEEMED
}

// Notification model (poll-based, never pushed)
model Notification {
  id          String           @id @default(cuid())
  // Multi-tenancy (v0.7) — set to recipient's active tenant at write time.
  tenantId    String           @map("tenant_id")
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  body        String
  data        Json?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")
  deliveredAt DateTime?        @map("delivered_at")
  batchId     String?          @map("batch_id")

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, read, createdAt])
  @@index([userId, read, createdAt])
  @@index([userId, batchId])
  @@map("notifications")
}

// Notification preferences (safety and parental always enabled, not configurable)
model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique @map("user_id")
  dmEnabled           Boolean @default(true) @map("dm_enabled")
  followEnabled       Boolean @default(true) @map("follow_enabled")
  digestEnabled       Boolean @default(true) @map("digest_enabled")
  systemEnabled       Boolean @default(true) @map("system_enabled")
  relationshipEnabled Boolean @default(true) @map("relationship_enabled")

  user User @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

// Out-of-band invite codes — users share codes privately; redemption establishes
// a relationship edge. Entity-scoped codes can be created by entity owners.
model ConnectionCode {
  id        String   @id @default(cuid())
  // Multi-tenancy (v0.7) — code's owning tenant (creator's active tenant at create time).
  tenantId  String   @map("tenant_id")
  code      String   @unique
  creatorId String   @map("creator_id")
  entityId  String?  @map("entity_id")
  expiresAt DateTime @map("expires_at")
  maxUses   Int      @map("max_uses")
  useCount  Int      @default(0) @map("use_count")
  createdAt DateTime @default(now()) @map("created_at")

  creator     User                       @relation("ConnectionCodeCreator", fields: [creatorId], references: [id])
  entity      Entity?                    @relation(fields: [entityId], references: [id])
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions ConnectionCodeRedemption[]

  @@index([tenantId])
  @@index([creatorId, expiresAt])
  @@index([entityId])
  @@map("connection_codes")
}

// One row per (code, redeemer). Composite unique prevents double-redemption under races.
model ConnectionCodeRedemption {
  id        String   @id @default(cuid())
  codeId    String   @map("code_id")
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  code   ConnectionCode @relation(fields: [codeId], references: [id])
  user   User           @relation(fields: [userId], references: [id])
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("connection_code_redemptions")
}

// ============================================================================
// MULTI-TENANCY MODEL (added in v0.7 — see plans/mvp/10-trellis-stages/01-schema-migration.md)
// ============================================================================

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique
  displayName String       @map("display_name")
  type        TenantType
  status      TenantStatus @default(ACTIVE)

  // Data-residency region for the tenant. Surfaced in the per-tenant
  // compliance bundle (`/api/tenants/:id/compliance.json`). Defaults to
  // "EU" since the platform's primary region is Frankfurt; tenants can
  // elect a different region during onboarding.
  region String @default("EU")

  // For PERSONAL tenants only — the single owner. Always equals the User.id who created it.
  personalOwnerUserId String? @unique @map("personal_owner_user_id")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  suspendedAt   DateTime? @map("suspended_at")
  suspendReason String?   @map("suspend_reason")

  // ── Per-tenant storage-quota entitlement (T16) ──
  // NULL = the tenant is on the platform's free-tier default, which arrives
  // via env (MEDIA_QUOTA_MAX_BYTES / MEDIA_QUOTA_MAX_OBJECTS — SSM-sourced in
  // the consumer's CDK; never a compiled literal). A non-null value is a
  // per-tenant OVERRIDE (entitlement seam only — billing/purchase flows are
  // deliberately out of scope; an operator or a future billing system writes
  // these columns). Resolution: effective = override ?? env default
  // (lib/media/quota-resolution.ts). What USAGE counts against the quota is
  // the shared storage-accounting predicate (lib/media/storage-accounting.ts:
  // lifecycle === APPROVED && deletedAt IS NULL) — see
  // doc/02-technical/operations/storage-accounting.md.
  storageQuotaBytes   BigInt? @map("storage_quota_bytes")
  storageQuotaObjects Int?    @map("storage_quota_objects")

  members          TenantMember[]
  domains          TenantDomain[]
  identityProvider TenantIdentityProvider?
  roleMappings     TenantRoleMapping[]
  invitations      TenantInvitation[]

  // Tenant-scoped resources
  entities                  Entity[]
  posts                     Post[]
  postComments              PostComment[]
  groups                    Group[]
  groupMembers              GroupMember[]
  entityOwnerships          EntityOwnership[]
  connectionCodes           ConnectionCode[]
  connectionCodeRedemptions ConnectionCodeRedemption[]
  notifications             Notification[]
  blockedUsers              BlockedUser[]

  // Denormalized tenant_id on by-relation children (P1 — for direct RLS).
  postMedia           PostMedia[]
  postSentiments      PostSentiment[]
  linkChecks          LinkCheck[]
  postGeoIndexes      PostGeoIndex[]
  productTaxonomyTags ProductTaxonomyTag[]
  entityLocations     EntityLocation[]

  // Personal-tenant owner back-relation (uses @relation name to disambiguate)
  personalOwner User? @relation("PersonalTenantOwner", fields: [personalOwnerUserId], references: [id])

  // Org classification + public directory (opt-in, orthogonal to TenantType)
  classification   TenantClassification?
  directoryProfile TenantDirectoryProfile?

  // AR10 prune: dropped [slug] (duplicate of @unique).
  @@index([type, status])
  @@map("tenants")
}

enum TenantType {
  PERSONAL
  ORGANIZATION
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETING // Phase 3 — soft state during cascade-delete
}

model TenantMember {
  id       String             @id @default(cuid())
  tenantId String             @map("tenant_id")
  userId   String             @map("user_id")
  role     TenantRole
  status   TenantMemberStatus @default(ACTIVE)

  isJitProvisioned Boolean   @default(false) @map("is_jit_provisioned")
  invitedByUserId  String?   @map("invited_by_user_id")
  invitedAt        DateTime? @map("invited_at")
  joinedAt         DateTime? @map("joined_at")
  removedAt        DateTime? @map("removed_at")
  lastActiveAt     DateTime? @map("last_active_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("TenantMemberships", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("TenantInvitedBy", fields: [invitedByUserId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([tenantId, role])
  @@map("tenant_members")
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum TenantMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model TenantDomain {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  domain            String    @unique // lowercased; no protocol
  verificationToken String    @map("verification_token") // 32 hex chars
  // Token expires 7 days after creation; admin must re-claim if expired (sec finding #5)
  tokenExpiresAt    DateTime  @map("token_expires_at")
  verifiedAt        DateTime? @map("verified_at")
  verifyAttemptedAt DateTime? @map("verify_attempted_at")
  verifyAttempts    Int       @default(0) @map("verify_attempts")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([verifiedAt])
  @@index([tokenExpiresAt])
  @@map("tenant_domains")
}

model TenantIdentityProvider {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")

  kind IdpKind

  // Cognito's IdP record name. Max 32 chars (Cognito quota), unique within the user pool.
  cognitoIdpName String @unique @map("cognito_idp_name")

  // SAML configuration
  metadataUrl String? @map("metadata_url")
  metadataXml String? @map("metadata_xml") @db.Text

  // OIDC configuration
  issuerUrl       String? @map("issuer_url")
  clientId        String? @map("client_id")
  clientSecretArn String? @map("client_secret_arn") // never the raw secret — Secrets Manager ARN
  scopes          String  @default("openid email profile groups")

  attributeMapping Json @default("{}") @map("attribute_mapping")

  // Default role applied when no TenantRoleMapping matches the user's IdP groups.
  // null means "deny if no group match."
  defaultRole TenantRole? @map("default_role")

  status      IdpStatus @default(PENDING)
  enabledAt   DateTime? @map("enabled_at")
  lastError   String?   @map("last_error") @db.Text
  lastErrorAt DateTime? @map("last_error_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [cognitoIdpName] (duplicate of @unique).
  @@index([status])
  @@map("tenant_identity_providers")
}

enum IdpKind {
  SAML
  OIDC
}

enum IdpStatus {
  PENDING
  ACTIVE
  DISABLED
  ERROR
}

model TenantRoleMapping {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  idpGroupName String     @map("idp_group_name")
  tenantRole   TenantRole @map("tenant_role")
  // Lower priority = higher precedence (admin-grants beat member-grants).
  priority     Int        @default(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idpGroupName])
  @@index([tenantId, priority])
  @@map("tenant_role_mappings")
}

model TenantInvitation {
  id               String     @id @default(cuid())
  tenantId         String     @map("tenant_id")
  email            String
  role             TenantRole
  token            String     @unique // signed JWT or random opaque token; one-shot
  expiresAt        DateTime   @map("expires_at")
  acceptedAt       DateTime?  @map("accepted_at")
  acceptedByUserId String?    @map("accepted_by_user_id")

  invitedByUserId String   @map("invited_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy  User   @relation("TenantInvitationInviter", fields: [invitedByUserId], references: [id])
  acceptedBy User?  @relation("TenantInvitationAcceptedBy", fields: [acceptedByUserId], references: [id])

  // AR10 prune: dropped [token] (duplicate of @unique).
  @@unique([tenantId, email])
  @@index([email])
  @@index([expiresAt])
  @@map("tenant_invitations")
}

// ============================================================================
// Org classification, directory & discovery (MVP / Phase 1)
// See analysis/org-classification-and-discovery/05-schema-changes.md.
// PlatformCategorySuggestion + its AI-curation pipeline are Phase 2 — NOT here.
// ============================================================================

// Platform-curated, NOT tenant-scoped — the single shared vocabulary every
// tenant's classification and every directory search draws from. Mirrors
// TaxonomyTaxon's hierarchical/synonym/translation shape but with no tenantId —
// curated by platform operators (SUPER_ADMIN), not tenants.
model PlatformCategory {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. "nonprofit", "nonprofit:animal-welfare"
  displayName String  @map("display_name")
  description String? @db.Text
  order       Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  synonyms     Json? // alternative search terms, e.g. ["charity", "NGO"]
  translations Json? // { "en": {...}, "de": {...} }

  parentCategoryId String?            @map("parent_category_id")
  parentCategory   PlatformCategory?  @relation("PlatformCategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories  PlatformCategory[] @relation("PlatformCategoryHierarchy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  classifications    TenantClassification[]
  classificationTags TenantClassificationTag[] @relation("ClassificationTagCategory")

  @@index([parentCategoryId])
  @@index([isActive])
  @@map("platform_categories")
}

// Named, not boolean — a verification badge with no visible source is exactly
// what the classification model's Q1 resolution rules out. Only SELF_DECLARED
// is ever set in MVP; the other values exist for Phase 2 verifier integrations.
enum VerificationSource {
  SELF_DECLARED
  TECHSOUP
  HAUS_DES_STIFTENS
  PLATFORM_MANUAL_REVIEW
}

// One row per tenant that has declared a classification. Absent = unclassified
// (the common case for a PERSONAL tenant with no business activity).
model TenantClassification {
  id         String @id @default(cuid())
  tenantId   String @unique @map("tenant_id")
  categoryId String @map("category_id") // may point anywhere in the PlatformCategory tree, not just a root

  verificationSource    VerificationSource @default(SELF_DECLARED) @map("verification_source")
  verifiedAt            DateTime?          @map("verified_at")
  // Case/record id at the verifying authority, when applicable — lets an admin
  // trace a TECHSOUP/HAUS_DES_STIFTENS claim back to its source record without
  // storing the verifier's full response body here.
  verifiedByRef         String?            @map("verified_by_ref")
  // Verification isn't only additive: a verifier can delist an org after the
  // fact. Set when a previously-verified classification's status is revoked, so
  // a stale "Verified via X" badge never survives a delisting.
  verificationRevokedAt DateTime?          @map("verification_revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category PlatformCategory          @relation(fields: [categoryId], references: [id])
  tags     TenantClassificationTag[]

  @@index([categoryId])
  @@index([verificationSource])
  @@map("tenant_classifications")
}

// Optional secondary tags for directory search only (never joined on the feed
// hot path). Tags are references into the SAME curated PlatformCategory tree as
// the primary category, not free text.
model TenantClassificationTag {
  id               String @id @default(cuid())
  tenantId         String @map("tenant_id")
  classificationId String @map("classification_id")
  categoryId       String @map("category_id")

  classification TenantClassification @relation(fields: [classificationId], references: [id], onDelete: Cascade)
  category       PlatformCategory     @relation("ClassificationTagCategory", fields: [categoryId], references: [id])

  @@unique([classificationId, categoryId])
  @@index([tenantId])
  @@index([categoryId])
  @@map("tenant_classification_tags")
}

// Location precision is a named level, not a boolean. The true coordinate is
// always stored (needed for correct proximity ranking); what varies by level is
// what the response exposes AND which query paths a row participates in.
enum LocationPrecision {
  EXACT // raw lat/lng + full address; participates in distance-sorted "near me" search
  NEIGHBORHOOD // coarsened pin + neighborhood label; participates in distance-sorted "near me" search
  CITY // city-level label only, no pin; EXCLUDED from distance-sorted/radius search — findable by name/category/explicit-city-match only
  HIDDEN // excluded from every geo query path — findable by name/category only
}

// Public directory profile (opt-in, separate from classification). Reuses the
// entity-geo storage shape. `lat`/`lng` are the true coordinates; ST_DWithin /
// distance ranking uses them ONLY when locationPrecision is EXACT or
// NEIGHBORHOOD — CITY/HIDDEN rows are excluded from radius/distance queries
// entirely, not just from the response payload (distance-sort order alone leaks
// the true coordinate via triangulation). `displayLat`/`displayLng` are a
// fuzzed/snapped coordinate safe to return for NEIGHBORHOOD-level map display;
// the fuzz radius is runtime config, not a hardcoded constant.
model TenantDirectoryProfile {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")

  isDiscoverable   Boolean @default(false) @map("is_discoverable")
  shortDescription String? @map("short_description") @db.Text

  lat               Float?
  lng               Float?
  displayLat        Float?
  displayLng        Float?
  locationLabel     String?           @map("location_label") // e.g. "Berlin, Germany" or "Prenzlauer Berg, Berlin"
  locationPrecision LocationPrecision @default(CITY) @map("location_precision")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([isDiscoverable])
  @@map("tenant_directory_profiles")
}

// ============================================================================
// Graph edges in Postgres (graph-db revisit 2026-06: see
// plans/redesign/graph-backend-contract.md)
//
// These two tables hold the relationship edges (user↔user and typed
// entity-to-entity). OWNS (entity_ownerships) and
// ABOUT (post_subjects) already existed in Postgres. Modeled as standalone
// tables (no Prisma @relation) so the migration is self-contained and
// non-breaking; targetId is polymorphic (user|entity) so it cannot carry a
// single FK. Cascade-on-delete is enforced in app code by the GraphService
// remove* methods, exactly as the graph layer did. Read by the Postgres
// GraphService adapter (apps/api/src/lib/graph/postgres/).
// ============================================================================

// RELATES_TO — a scored relationship from a user to a target (user or entity).
model Relationship {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id") // denormalized scope, like entity_ownerships
  userId   String @map("user_id")

  // Polymorphic target: "user" | "entity" (matches GraphNodeType). No FK.
  targetType String @map("target_type")
  targetId   String @map("target_id")

  computedScore     Float     @default(0) @map("computed_score")
  manualScore       Float?    @map("manual_score") // null = no override
  tier              Int       @default(3) // CircleTier 0..3
  interactionCount  Int       @default(0) @map("interaction_count")
  lastInteractionAt DateTime? @map("last_interaction_at")
  connectionMethod  String    @map("connection_method") // code|import|suggestion|discovery
  reciprocated      Boolean   @default(false)
  // Per-interaction-type signal breakdown used by scoring-engine.ts.
  // Shape finalized in Phase 1 (B5) against the scoring engine; JSON keeps the
  // migration stable while that lands.
  signals           Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // AR10 prune: dropped [userId] (prefix of the composite unique and of
  // [userId, tier]) and the bare [targetId] (polymorphic reverse lookups are
  // always type-qualified → [targetType, targetId] carries them).
  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId]) // reverse: who relates to X (FoF, recompute)
  @@index([userId, tier]) // circle-tier membership
  @@index([tenantId])
  @@map("relationships")
}

// Typed, unscored entity-to-entity edge, confirmable.
//
// `type` is a String, NOT a Postgres enum (pre-launch schema end-state pass):
// the edge vocabulary is DOMAIN vocabulary (the current values — PACK_MATE,
// SIBLING, PLAYMATE, PARENT, OFFSPRING, WALK_BUDDY — are dog-domain terms),
// and trellis is the domain-agnostic core. Baking a vertical's vocabulary
// into a DB enum would force every other vertical (and every vocabulary
// change) through an ALTER TYPE migration. The vocabulary is enforced in app
// code instead — the hand-written union in lib/graph/types.ts, the
// allowlist in entity-relationship-handler.ts, and the fixed traversal set
// in lib/graph/postgres/discovery.ts (raw SQL compares the text column
// directly — the enum-era `::text` casts were dropped by AR8). Same
// deliberate pattern as InteractionEvent.interactionType and
// MediaModerationJob.decision.
model EntityRelationship {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  entityId         String                   @map("entity_id")
  relatedEntityId  String                   @map("related_entity_id")
  type             String
  status           EntityRelationshipStatus @default(PENDING)
  proposedByUserId String                   @map("proposed_by_user_id")

  since     DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entityId, relatedEntityId, type])
  @@index([entityId, type, status]) // discovery / list-by-entity
  @@index([relatedEntityId, type, status]) // reverse / pending-by-owner
  @@index([tenantId])
  @@map("entity_relationships")
}

enum EntityRelationshipStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Realtime / server-blind settings sync — opaque AEAD blob the server cannot read.
model EncryptedUserSetting {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  namespace  String // allowlisted, e.g. "feed_filters"
  ciphertext String   @db.Text // opaque AEAD blob; the server cannot read it
  version    Int      @default(1) // monotonic per (user, namespace)
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [userId] (prefix of the composite unique).
  @@unique([userId, namespace])
  @@map("encrypted_user_settings")
}

// Realtime delivery safety floor — blocked-sender relation (who blocks whom).
model BlockedUser {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  blocker User   @relation("BlockedUserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User   @relation("BlockedUserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [tenantId, blockerId] (prefix of the composite unique).
  @@unique([tenantId, blockerId, blockedId])
  @@map("blocked_users")
}

// ============================================================================
// Open Social Web (plan: trellis-internal/plans/open-social-web)
// ----------------------------------------------------------------------------
// Cross-references (targetId, ownerUserId) are DENORMALIZED strings with no FK,
// matching the Relationship/InteractionEvent polymorphic precedent; cascade on
// referent delete is enforced in app code, not the DB. (Deviation from design
// 03 §2 which showed an owner FK — traded for a purely-additive migration that
// does not touch the User model.)
// ============================================================================

/// Anonymous email follower of a public target. The CONFIRMED row is itself the
/// consent artifact (double opt-in = GDPR Art. 6(1)(a)); unsubscribe = withdrawal
/// (Art. 7(3)). No User FK — subscribers have no account. The email is stored
/// encrypted (per-record envelope ciphertext) plus a keyed HMAC hash for lookup;
/// both carry a keyVersion prefix so keys can rotate. Client IP/UA at subscribe
/// time is NOT stored here — it goes through SecurityEvent (retention-bound).
model EmailSubscription {
  id             String                  @id @default(uuid()) // random v4 (NOT cuid) — token entropy
  tenantId       String                  @map("tenant_id") // denormalized; no FK (polymorphic precedent)
  targetType     String                  @map("target_type") // "user" | "entity" (Relationship vocab)
  targetId       String                  @map("target_id") // polymorphic; no FK
  emailHash      String                  @map("email_hash") // "v{n}:" + keyed HMAC-SHA256(normalized email)
  emailEnc       String                  @map("email_enc") // "v{n}:" + envelope ciphertext (per-record DEK)
  tokenNonce     String                  @map("token_nonce") // random; bound into capability-token HMAC
  status         EmailSubscriptionStatus @default(PENDING)
  locale         String? // BCP-47, for localized digest
  confirmedAt    DateTime?               @map("confirmed_at") // double opt-in timestamp = consent
  unsubscribedAt DateTime?               @map("unsubscribed_at") // withdrawal
  lastDigestAt   DateTime?               @map("last_digest_at") // digest high-water mark (digest job deferred)
  bounceCount    Int                     @default(0) @map("bounce_count")
  retentionUntil DateTime                @map("retention_until") // NON-NULL — pruned by hourly cron
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([tenantId, targetType, targetId, emailHash]) // one sub per (target, email)
  @@index([targetType, targetId, status]) // "confirmed subs for target X"
  @@index([status, retentionUntil]) // prune scan
  @@index([tenantId])
  @@map("email_subscriptions")
}

enum EmailSubscriptionStatus {
  PENDING // awaiting double-opt-in confirmation
  CONFIRMED // active
  UNSUBSCRIBED // withdrawn; emailEnc scrubbed, emailHash kept for suppression
  BOUNCED // hard bounce / complaint; suppressed (see EmailSuppression)
}

/// A user-authored, ordered curated list of profiles (users and/or entities) for
/// discovery — Mastodon-style "Collections". Not an algorithmic recommender.
model Collection {
  id          String               @id @default(cuid())
  tenantId    String               @map("tenant_id")
  ownerUserId String               @map("owner_user_id") // always a real user; denormalized (app-code cascade)
  title       String
  description String?
  visibility  CollectionVisibility @default(PRIVATE)
  itemCount   Int                  @default(0) @map("item_count") // denormalized, capped in handler
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  items CollectionItem[]

  @@index([ownerUserId])
  @@index([tenantId, visibility])
  @@map("collections")
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  targetType   String   @map("target_type") // "user" | "entity"
  targetId     String   @map("target_id") // polymorphic; no FK
  position     Int // manual ordering
  note         String? // optional per-item curator note
  addedAt      DateTime @default(now()) @map("added_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, targetType, targetId]) // no dupes within a list
  @@index([collectionId, position])
  @@map("collection_items")
}

enum CollectionVisibility {
  PUBLIC // browsable + discoverable
  UNLISTED // link-shareable, not surfaced in discovery
  PRIVATE // owner only
}
