generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Prisma 7: url/directUrl moved out of the datasource block. The migration
  // connection lives in apps/api/prisma.config.ts; the runtime connection is
  // supplied via the PrismaPg driver adapter (lib/database-connection-manager.ts).
}

// Generic Entity model (replaces Dog model)
model Entity {
  id         String  @id @default(cuid())
  // Multi-tenancy (v0.7) — every entity belongs to exactly one tenant.
  tenantId   String  @map("tenant_id")
  name       String
  entityType String? @map("entity_type") // 'pet', 'product', 'event', etc. (defaults to 'dog' for MVP)
  metadata   Json? // Flexible schema for entity-specific fields (breed, bio, birthdate, breedSize, etc.)

  // Entity lifecycle
  status           EntityStatus @default(ACTIVE)
  deceasedAt       DateTime?    @map("deceased_at")
  memorialSettings Json?        @map("memorial_settings") // { commentsOpen: boolean, ... }

  // Life stage fields (auto-calculated from birthdate and breedSize in metadata)
  lifeStage               String?   @map("life_stage") // Taxonomy ID: "life-stage:puppy"
  lifeStageManualOverride Boolean   @default(false) @map("life_stage_manual_override")
  lifeStageCalculatedAt   DateTime? @map("life_stage_calculated_at")

  // ActivityPub federation fields
  actorUri     String? @unique @map("actor_uri") // e.g. https://example.com/ap/entities/{id}
  inboxUrl     String? @map("inbox_url")
  outboxUrl    String? @map("outbox_url")
  followersUrl String? @map("followers_url")
  publicKey    String? @map("public_key") // PEM-encoded RSA public key
  privateKey   String? @map("private_key") // PEM-encoded RSA private key (encrypted at rest)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Co-ownership (replaces single ownerId)
  owners EntityOwnership[]
  // Relationships and follower counts live in the graph edge tables (served via graph-service.ts), not on this model

  subjectPosts PostSubject[]
  primaryPosts Post[]              @relation("PrimaryEntityPosts")
  taxonomyTags EntityTaxonomyTag[]

  connectionCodes ConnectionCode[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [tenantId] (prefix of the composite below), [status]
  // and [entityType, status] (all entity reads are tenant-scoped).
  @@index([tenantId, entityType, status])
  @@map("entities")
}

enum EntityStatus {
  ACTIVE
  MEMORIAL
  TRANSFERRED
}

// Media lifecycle state (T14/AR4 consolidation). Mirrors the hand-written
// MediaLifecycle union in apps/api/src/lib/media/media-lifecycle.ts — spelling
// must match. ONE state machine replaces the former ModerationStatus enum +
// uploadStatus string pair:
//
//   AWAITING_UPLOAD -> UPLOADED -> APPROVED | REVIEW | QUARANTINED | REJECTED
//   AWAITING_UPLOAD | UPLOADED -> UPLOAD_FAILED   (expiry/abandon/reap)
//   REVIEW | QUARANTINED --human--> APPROVED | REJECTED
//   (any) --csam--> REJECTED
//
// Every new MediaFile is born AWAITING_UPLOAD (fail-closed); the ONLY state
// that can serve bytes is APPROVED (and only with !hidden && deletedAt=null —
// see lib/media/serve-gate.ts).
enum MediaLifecycle {
  AWAITING_UPLOAD
  UPLOADED
  APPROVED
  REVIEW
  QUARANTINED
  REJECTED
  UPLOAD_FAILED
}

model PostGeoIndex {
  postUri   String   @id @map("post_uri")
  // Multi-tenancy — denormalized from the owning post; location data is
  // sensitive, so geo rows carry their own tenant_id for direct RLS.
  tenantId  String   @map("tenant_id")
  entityRef String?  @map("entity_ref") // Generic entity reference
  geohash   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at")
  place     String?
  labels    Json?    @default("[]")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityRef])
  @@index([geohash])
  @@map("post_geo_index")
}

/// Entity geo-location for proximity discovery (C7). Geo-proximity is queried
/// with PostGIS (ST_DWithin / KNN over a GiST index) via $queryRaw. Populated from
/// syncEntity. Location is sensitive → own tenant_id for direct RLS
/// (mirrors post_geo_index). See plans/redesign/entity-location-subsystem.md.
model EntityLocation {
  entityId  String                                @id @map("entity_id")
  tenantId  String                                @map("tenant_id")
  // PostGIS geography(Point,4326). Prisma Client cannot filter/order on it —
  // spatial reads/writes go through $queryRaw. The geography column type, GiST
  // index, and RLS are added in the migration SQL (not derivable from Prisma).
  location  Unsupported("geography(Point, 4326)")
  lat       Float
  lng       Float
  updatedAt DateTime                              @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("entity_location")
}

// User roles
enum UserRole {
  END_USER
  B2B_PARTNER
  PARTNER_ADMIN
  INTERNAL
  CONTENT_CREATOR
  MODERATOR // Surveillance-hardening Phase 0 (E5): moderation-queue access; routes are Phase 1
  SUPER_ADMIN
}

// Surveillance-hardening Phase 0 (E2): how an account was created. Nullable on
// User — existing accounts predate capture and stay NULL (unknown), never
// backfilled. See doc/02-technical/surveillance-threat-model/03-signup-...
enum SignupMethod {
  COGNITO
  INVITE
  MAGIC_LINK
}

// Surveillance-hardening Phase 0 (E3): discriminator for the generalized Report
// model. LINK reports exist today (folded in from LinkReport, P4); ACCOUNT
// reports are Phase 1 (just a new reportType, not a new subsystem).
enum ReportType {
  LINK
  ACCOUNT
}

// Role metadata for UI display and documentation
model RoleMetadata {
  role        UserRole @id // Maps to enum value
  displayName String   @map("display_name") // Human-readable name (e.g., "Partner Administrator")
  description String? // Detailed description of role permissions
  category    String // 'partner', 'internal', 'system', 'end_user'
  permissions Json? // Role-specific permissions (for UI display)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("role_metadata")
}

// User model for feed posts
// Using Cognito sub (UUID) as primary key via cognitoSub field
// actorUri is the ActivityPub actor identifier
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      UserRole @default(END_USER)
  actorUri  String?  @unique @map("actor_uri") // ActivityPub actor URI (e.g., "https://example.com/users/{handle}")
  // Canonical, portable, AP-actor-shaped identifier (S-CP2). The bare local
  // label (e.g. "alice"); the addressable handle is `@{handle}@{domain}` and
  // the actor URI is `{baseUrl}/users/{handle}`. Derived + collision-checked at
  // provisioning; non-null + globally unique so federation is additive, never a
  // migration. (WebFinger/AP still resolve on `username` until the federation
  // repoint — that change is code-only, no data migration, since `handle` is the
  // stable key.)
  handle    String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Cognito Auth integration
  cognitoSub String? @unique @map("cognito_sub") // Cognito user pool sub (UUID), nullable for migration safety

  // User Deprovisioning
  suspended       Boolean   @default(false)
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")

  // Multi-tenancy (v0.7) — user's auto-created personal tenant.
  // Nullable to allow brief moments during sign-up before personal tenant exists.
  personalTenantId String? @unique @map("personal_tenant_id")

  // Account Deletion Grace Period
  deletionRequestedAt DateTime? @map("deletion_requested_at") // When user requested deletion
  deletionScheduledAt DateTime? @map("deletion_scheduled_at") // When hard deletion will occur (7 days after request)
  deletionConfirmedAt DateTime? @map("deletion_confirmed_at") // When user confirmed deletion (2FA/confirmation)

  // PREPARATORY CHANGE: Username field for future pseudonymous sign-up
  // Currently optional, will be required when implementing pseudonymous authentication
  // This field allows users to sign up without email (for at-risk users)
  username String? @unique

  // PREPARATORY CHANGE: Privacy settings for future spy-protection features
  // All fields default to current behavior (no breaking changes)
  // These will be used when implementing stealth mode and location safety features

  // Stealth mode: Hide online status, typing indicators, last seen
  // FUTURE USE: When stealth mode is enabled, hide user's online presence
  stealthMode Boolean @default(false) @map("stealth_mode")

  // Online status visibility controls
  // FUTURE USE: Control what presence information is visible to others
  showOnlineStatus    Boolean @default(true) @map("show_online_status")
  showTypingIndicator Boolean @default(true) @map("show_typing_indicator")
  showLastSeen        Boolean @default(true) @map("show_last_seen")

  // Location tracking and anonymization
  // FUTURE USE: Allow users to disable location tracking or anonymize location data
  locationTrackingEnabled    Boolean @default(true) @map("location_tracking_enabled")
  // 0=exact, 1=100m, 2=1km, 3=city-level
  // FUTURE USE: Automatically round location coordinates based on this level
  locationAnonymizationLevel Int     @default(0) @map("location_anonymization_level")

  // Analytics opt-out
  // FUTURE USE: Respect user preference when sending analytics events
  analyticsOptOut Boolean @default(false) @map("analytics_opt_out")

  // Surveillance-hardening Phase 0 (E2): signup-metadata capture (P3 wires it).
  // signupMethod records how the account was created; invitationId links the
  // redeemed invitation. Client signals (IP/UA) go to SecurityEvent (retention-
  // bound), NEVER as columns here — see 07-data-minimization.md. Both nullable:
  // existing accounts stay NULL (unknown), no fabricated backfill.
  signupMethod SignupMethod? @map("signup_method")
  invitationId String?       @map("invitation_id")

  // Verification Status (synced from Cognito)
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Badge Display Preferences
  showVerifiedBadge Boolean @default(true) @map("show_verified_badge") // User can hide badge

  // Identity Verification (Anti-Impersonation)
  // Helps users identify real accounts vs fake/impersonation accounts
  identityVerified             Boolean   @default(false) @map("identity_verified")
  identityVerifiedAt           DateTime? @map("identity_verified_at")
  identityVerificationMethod   String?   @map("identity_verification_method") // 'automated', 'manual', 'self_service'
  identityVerificationProvider String?   @map("identity_verification_provider") // 'jumio', 'onfido', 'veriff', 'manual'
  showIdentityVerifiedBadge    Boolean   @default(true) @map("show_identity_verified_badge")

  // PREPARATORY CHANGE: Region tracking for multi-region support
  // region: User's detected region (where they're located)
  // dataRegion: Where user's data is stored (for compliance)
  // FUTURE USE: When CN-region support is enabled, dataRegion will be used
  // to route data to the correct regional database
  region     String  @default("EU") @map("region") // User's region (US, EU, CN)
  dataRegion String? @map("data_region") // Where data is stored (for compliance)

  posts              Post[]
  securityEvents     SecurityEvent[]
  createdInvitations Invitation[]    @relation("CreatedInvitations")
  usedInvitations    Invitation[]    @relation("UsedInvitations")
  consents           Consent[]

  // Circle configuration and read state
  circleConfig     CircleConfig?
  circleReadStates CircleReadState[]

  // Entity co-ownership
  ownedEntities   EntityOwnership[] @relation("EntityOwners")
  addedOwnerships EntityOwnership[] @relation("OwnershipAddedBy")

  // Relationships and follower counts live in the graph edge tables (served via graph-service.ts), not on this model

  // Direct messages
  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")

  // Custom audiences
  createdAudiences    CustomAudience[]       @relation("AudienceCreator")
  audienceMemberships CustomAudienceMember[] @relation("AudienceMembers")

  // Surveillance-hardening Phase 0: behavioral-event actor side (E1, P2) and
  // generalized reports filed BY this user (E3, P4). Both cascade on delete.
  interactionEvents InteractionEvent[] @relation("InteractionActor")
  filedReports      Report[]           @relation("ReportReporter")

  // Surveillance-hardening Phase 0 (E2): the invitation this user redeemed at
  // signup, if any. Distinct from createdInvitations / usedInvitations.
  signupInvitation Invitation? @relation("SignupInvitation", fields: [invitationId], references: [id])

  // ActivityPub protocol fields
  inboxUrl     String? @map("inbox_url") // ActivityPub inbox endpoint
  outboxUrl    String? @map("outbox_url") // ActivityPub outbox endpoint
  followersUrl String? @map("followers_url") // Followers collection URL
  followingUrl String? @map("following_url") // Following collection URL
  friendsUrl   String? @map("friends_url") // Friends collection URL (optional)
  publicKey    String? @map("public_key") // Public key in PEM format
  privateKey   String? @map("private_key") // Private key in PEM format (encrypted at rest)

  // AR10 prune (pre-launch schema end-state pass): the dormant Border-Safety
  // prep cluster (encryptionKeyId, defaultContext, travelMode*,
  // panicActionConfig, emailHash, messageRetentionDays, autoDeleteAfterDays,
  // and the UserEncryptionKey table) had ZERO code references and was removed.
  // When Border Safety Mode is actually built, it gets a designed-for-purpose
  // schema — not these speculative columns.

  // Anonymous identifier for privacy (KEYED pseudonym — see lib/pseudonym.ts)
  anonymousId String? @unique @map("anonymous_id")

  // MFA enrollment relation
  mfaEnrollment MfaEnrollment?

  // Push device registrations (T8)
  pushDevices PushDevice[]

  // Safer Social Design: Age verification (Phase 1)
  dateOfBirth DateTime? @map("date_of_birth")
  ageTier     AgeTier   @default(ADULT) @map("age_tier")

  // Fail-CLOSED age signal for research/cohort inclusion. Distinct from
  // `ageTier` (which fails OPEN at ADULT — a deliberate, accepted product-side
  // minor-safety choice, see PSEUDONYM.md / RESEARCH-AGE-SIGNAL note). Any
  // future research or cohort query MUST gate on `ageVerified = true`. `ageTier`
  // is NEVER an includability signal: an unverified user defaults to ADULT and
  // would otherwise leak into adult cohorts.
  ageVerified Boolean @default(false) @map("age_verified")

  // Parental links
  parentalLinks ParentalLink[] @relation("ChildParentalLinks")
  guardianLinks ParentalLink[] @relation("GuardianParentalLinks")

  // Safer Social Design: Quiet hours (Phase 2)
  quietHoursStart   Int?    @map("quiet_hours_start") // minutes from midnight (e.g., 1320 = 10PM)
  quietHoursEnd     Int?    @map("quiet_hours_end") // minutes from midnight (e.g., 420 = 7AM)
  quietHoursEnabled Boolean @default(false) @map("quiet_hours_enabled")

  // Safer Social Design: Profile visibility and DM access (Phase 5)
  profileVisibility ProfileVisibility @default(PUBLIC) @map("profile_visibility")
  dmAccess          DmAccess          @default(CONNECTIONS) @map("dm_access")

  // Safer Social Design: Notifications (Phase 4)
  notifications          Notification[]
  notificationPreference NotificationPreference?

  // Realtime / server-blind settings sync
  encryptedSettings EncryptedUserSetting[]
  blocksInitiated   BlockedUser[]          @relation("BlockedUserBlocker")
  blockedBy         BlockedUser[]          @relation("BlockedUserBlocked")

  // Connection codes (out-of-band invite mechanism)
  createdConnectionCodes  ConnectionCode[]           @relation("ConnectionCodeCreator")
  redeemedConnectionCodes ConnectionCodeRedemption[]

  // Multi-tenancy relations (v0.7)
  personalTenant       Tenant?            @relation("PersonalTenantOwner")
  tenantMemberships    TenantMember[]     @relation("TenantMemberships")
  invitedTenantMembers TenantMember[]     @relation("TenantInvitedBy")
  sentInvitations      TenantInvitation[] @relation("TenantInvitationInviter")
  acceptedInvitations  TenantInvitation[] @relation("TenantInvitationAcceptedBy")

  // AR10 prune: dropped the single-column indexes duplicating @unique fields
  // (username, actorUri, anonymousId, cognitoSub, personalTenantId — a unique
  // constraint already creates the index), the low-cardinality boolean/flag
  // indexes never used as scan predicates (suspended, emailVerified,
  // identityVerified), the region/dataRegion indexes (no user-table scan
  // filters on them; region routing happens above the DB), and the indexes on
  // pruned dormant columns. users is a hot write path (login/profile churn) —
  // every surviving index must earn its write cost.
  @@index([role])
  @@index([invitationId]) // Phase 0 (E2): invitation-chain traversal, Phase 2 detection only
  @@map("users")
}

// MFA enrollment for admin roles (AUTH-1)
model MfaEnrollment {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret String    @map("encrypted_secret") @db.Text
  backupCodes     String[]  @map("backup_codes") // hashed, one-time use
  enrolledAt      DateTime  @default(now()) @map("enrolled_at")
  lastUsedAt      DateTime? @map("last_used_at")

  @@map("mfa_enrollments")
}

// Push notification platform a device token belongs to (T8).
enum PushPlatform {
  APNS
  FCM
  WEB
}

// T8 — registered push device tokens (frozen contract:
// apps/api/src/lib/doc/push-device-contract.md).
//
// The raw platform token is stored AES-GCM encrypted (the MfaEnrollment
// encryptedSecret pattern, SESSION_SECRET-keyed); `tokenHash` (SHA-256 hex of
// the raw token) is the deterministic dedupe/upsert key. `tokenHash` is
// GLOBALLY unique — one token identifies one physical device, which belongs to
// exactly one account at a time; re-registering an existing token reassigns
// the row (last registration wins, the account-switch case).
model PushDevice {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  platform        PushPlatform
  tokenHash       String       @unique @map("token_hash") // SHA-256 hex of the raw token
  tokenCiphertext String       @map("token_ciphertext") @db.Text // AES-GCM at rest
  createdAt       DateTime     @default(now()) @map("created_at")
  lastSeenAt      DateTime     @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // dispatcher lookup path
  @@map("push_devices")
}

// Purpose discriminator for the unified Consent model.
//   CROSS_REGION           — GDPR cross-region data-access consent (sets
//                            dataRegion/accessRegion; studyId is NULL).
//   RESEARCH_OBSERVATION   — opt-in to observational research (no per-study
//                            intervention; studyId set).
//   RESEARCH_PARTICIPATION — opt-in to active study participation (studyId set).
enum ConsentPurpose {
  CROSS_REGION
  RESEARCH_OBSERVATION
  RESEARCH_PARTICIPATION
}

// Purpose-tagged consent (generalised from the old CrossRegionConsent).
//
// CONSENT-HISTORY DESIGN — APPEND-ONLY (GDPR Art.7(1)/(3), IRB audit):
//   Each grant or withdrawal is a NEW row. A grant/withdraw never mutates an
//   earlier row, so the original `consentedAt` of every grant is preserved
//   forever and the full lifecycle is reconstructable. The CURRENT state for a
//   (user, purpose, key) is the single row with `active = true`; superseding a
//   row sets `active = false` + `supersededAt = now()`. `withdrawnAt` records
//   when consent was withdrawn ON the row that recorded it (a withdrawal row
//   carries consented=false + withdrawnAt set and PRESERVES the grant's
//   consentedAt if it descends from one — never null it).
//
//   Uniqueness is therefore keyed on ACTIVE rows only:
//     - research rows (studyId non-null): @@unique([userId, purpose, studyId]).
//       NOTE Postgres treats NULLs as DISTINCT, so this composite does NOT
//       constrain CROSS_REGION rows (studyId is NULL there) — by design.
//     - CROSS_REGION rows: a RAW partial unique index in the migration:
//         CREATE UNIQUE INDEX consent_cross_region_key
//           ON consent (user_id, data_region, access_region)
//           WHERE purpose = 'CROSS_REGION' AND active;
//       This preserves the pre-existing @@unique([userId, dataRegion,
//       accessRegion]) guarantee for the active cross-region row.
model Consent {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  purpose      ConsentPurpose @default(CROSS_REGION)
  // Research consents only. NULL for CROSS_REGION rows.
  studyId      String?        @map("study_id")
  // Cross-region consents only. NULL for research rows.
  dataRegion   String?        @map("data_region") // Where data is stored (e.g., "EU")
  accessRegion String?        @map("access_region") // Region user is accessing from (e.g., "US")
  consented    Boolean        @default(false)
  consentedAt  DateTime?      @map("consented_at")
  withdrawnAt  DateTime?      @map("withdrawn_at")
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")
  // Append-only history discriminators.
  active       Boolean        @default(true)
  supersededAt DateTime?      @map("superseded_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Research-row uniqueness (studyId non-null). Does NOT cover CROSS_REGION
  // rows — those are constrained by the raw partial index in the migration.
  // AR10 prune: dropped [userId] (prefix of [userId, purpose, active]), the
  // boolean [consented], and [dataRegion, accessRegion] (all consent reads
  // are user-scoped).
  @@unique([userId, purpose, studyId])
  @@index([userId, purpose, active])
  @@map("consent")
}

// Posting radius — how far content radiates on the author's social graph
enum PostRadius {
  WHISPER // Inner circle only (tier 0)
  NORMAL // Close friends + inner circle (tiers 0-1)
  LOUD // Community and closer (tiers 0-2)
  SHOUT // Everyone (all tiers)
}

// Privacy levels for follow relationships
enum Privacy {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

// Post model (unified for all visibility levels)
model Post {
  id              String     @id @default(cuid())
  // Multi-tenancy (v0.7) — set to author's active tenant at write time.
  tenantId        String     @map("tenant_id")
  authorId        String     @map("author_id")
  text            String     @db.Text
  radius          PostRadius @default(NORMAL)
  geoData         Json?      @map("geo_data")
  uri             String? // ActivityPub URI (for public posts)
  contentWarnings String[]   @map("content_warnings")
  deletedAt       DateTime?  @map("deleted_at")
  hiddenByAuthor  Boolean    @default(false) @map("hidden_by_author")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  editedAt        DateTime?  @map("edited_at") // Timestamp of last user edit (null if never edited)

  author          User              @relation(fields: [authorId], references: [id])
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group           Group?            @relation(fields: [groupId], references: [id])
  groupId         String?           @map("group_id") // Group this post belongs to
  media           PostMedia[]
  sentiments      PostSentiment[]
  comments        PostComment[]
  subjectEntities PostSubject[]
  primaryEntityId String?           @map("primary_entity_id")
  primaryEntity   Entity?           @relation("PrimaryEntityPosts", fields: [primaryEntityId], references: [id])
  taxonomyTags    PostTaxonomyTag[]
  linkChecks      LinkCheck[]

  // PREPARATORY CHANGE: Region tracking for multi-region support
  // dataRegion: Where post data is stored (for compliance)
  // FUTURE USE: When CN-region support is enabled, dataRegion will be used
  // to route data to the correct regional database
  dataRegion String? @map("data_region") // Where post data is stored (for compliance)

  // ActivityPub fields (nullable for backward compatibility)
  activityId String?   @unique @map("activity_id") // Activity URI (e.g., "https://example.com/posts/{id}/activity")
  objectId   String?   @unique @map("object_id") // Note object URI (e.g., "https://example.com/posts/{id}")
  to         Json? // Audience targeting (array of URIs)
  cc         Json? // Additional audience
  bto        Json? // Blind recipients (for private posts)
  bcc        Json? // Blind carbon copy
  published  DateTime? @map("published") // ISO 8601 timestamp (for ActivityPub, defaults to createdAt)

  // Link security fields
  hasBlockedLinks Boolean @default(false) @map("has_blocked_links")

  // AR10 prune: the dormant classification columns (sensitivityLevel,
  // ownerContext, screeningRiskLevel, contentCategory) were written-by-default
  // and read by nothing; removed pre-launch. Border-Safety / context-aware
  // access gets a designed schema when it is actually built.

  // Feed-declutter denormalization (org classification). Resolved by walking
  // PlatformCategory.parentCategoryId to the root at write time, from the
  // author's active tenant's TenantClassification. Null when the author's
  // tenant has no declared classification. Deliberately coarser than the
  // tenant's actual categoryId — feed decluttering only needs the root
  // ("is this a business/nonprofit/etc. post"), not the leaf. Fine-grained
  // category browsing is a directory concern, not a feed one. Staleness is
  // accepted the same way contentCategory already accepts it: already-written
  // posts keep their old value unless explicitly backfilled.
  authorOrgRootCategoryCode String? @map("author_org_root_category_code") // PlatformCategory.code of the root ancestor

  // AR10 prune (posts is the hottest write path — 17 indexes reduced to 7):
  // dropped [activityId]/[objectId] (duplicate their @unique), [uri] (AP
  // object lookups go through the @unique objectId/activityId; nothing
  // queries by uri), [deletedAt] (always combined with selective predicates;
  // a bare mostly-NULL index never wins), [editedAt] (nothing queries edited
  // posts), [dataRegion, createdAt] (single-region launch — with dataRegion
  // constant it degenerates to [createdAt], which stays), and the four
  // dormant-classification indexes (columns pruned above).
  @@index([tenantId, createdAt])
  @@index([authorId, createdAt])
  @@index([authorId, radius, createdAt])
  @@index([primaryEntityId])
  @@index([createdAt])
  @@index([groupId]) // Index for group posts
  @@index([authorOrgRootCategoryCode, createdAt]) // Feed-declutter predicate (org classification)
  @@map("posts")
}

// Media files (tenant-scoped content-addressed storage).
// tenantId is NOT NULL — every object belongs to exactly one tenant.
// Dedup is within-tenant: @@unique([tenantId, contentHash]).
// Every new object is born PENDING (fail-closed); the moderation pipeline
// advances objects to APPROVED before they can be served.
model MediaFile {
  id           String  @id @default(cuid())
  tenantId     String  @map("tenant_id") // Tenant that owns this object (NOT NULL)
  contentHash  String? @map("content_hash") // SHA-256 hash (lowercase hex); null until post-transcode for video (set by the P0b worker)
  mimeType     String  @map("mime_type")
  size         Int
  // uploadId: client-side idempotency key for the upload session. Nullable
  // because rows created before P0b (or via the reconciliation path) have no
  // upload session. UNIQUE so the same upload cannot race into two rows.
  uploadId     String? @unique @map("upload_id")
  // originalKey: S3 CAS key for the raw ingested object. Nullable for video —
  // the CAS key is computed post-transcode by the pipeline worker; the row
  // exists before transcoding completes.
  originalKey  String? @map("original_key") // S3 key: cas/{tenantId}/{hash} (null until transcode for video)
  thumbnailKey String? @map("thumbnail_key") // S3 key: cas/{tenantId}/{hash}/thumbnail (see lib/media/cas-keys.ts — the ONLY key builder)
  optimizedKey String? @map("optimized_key") // S3 key: cas/{tenantId}/{hash}/optimized (see lib/media/cas-keys.ts)

  // Lifecycle state — THE gate (see MediaLifecycle enum above; T14/AR4
  // consolidation of the former moderationStatus + uploadStatus pair).
  // Default AWAITING_UPLOAD means every object is fail-closed until bytes are
  // confirmed AND moderation approves. The sync-image path creates rows
  // directly at their resolved verdict (bytes + verdict are known atomically).
  lifecycle MediaLifecycle @default(AWAITING_UPLOAD) @map("lifecycle")

  // Media metadata (extracted from file headers)
  width    Int? // Image/video width in pixels
  height   Int? // Image/video height in pixels
  duration Int? @map("duration") // Video duration in seconds

  // Raw metadata payloads (JSON)
  exifData      Json? @map("exif_data")
  iptcData      Json? @map("iptc_data")
  videoMetadata Json? @map("video_metadata")

  // Denormalized/unified metadata fields
  // GPS coordinates are NOT stored — dropped at ingestion (data-minimization).
  dateTaken DateTime? @map("date_taken")
  keywords  String[]  @default([]) @map("keywords")

  // Privacy flags. metadataVisible defaults false: metadata is private unless
  // the owner explicitly shares it (data-minimization default).
  metadataVisible Boolean @default(false) @map("metadata_visible")
  locationVisible Boolean @default(false) @map("location_visible")

  // Media visibility and deletion tracking. DELIBERATELY NOT part of the
  // lifecycle enum (T14/AR4): `hidden` is a moderator-reversible visibility
  // toggle on an (usually APPROVED) object and `deletedAt` is the deletion
  // audit timestamp — folding either into `lifecycle` would destroy the
  // underlying moderation verdict on unhide/undelete. The serve gate is
  // `lifecycle === APPROVED && !hidden && deletedAt == null` (serve-gate.ts).
  hidden    Boolean   @default(false) // Hide from posts (soft delete)
  deletedAt DateTime? @map("deleted_at") // Permanent deletion timestamp
  hiddenAt  DateTime? @map("hidden_at") // When media was hidden
  hiddenBy  String?   @map("hidden_by") // User ID who hid the media

  // (T14/AR4: the former uploadStatus String column is consolidated into
  // `lifecycle` above. AR10 prune history: the never-read reconciliation
  // bookkeeping columns and the AT-Protocol `cid` column were removed earlier.)
  uploadedBy String? @map("uploaded_by")

  // Optimistic upload tracking (for orphaned media cleanup). DELIBERATELY NOT
  // part of the lifecycle enum (T14/AR4): attachment is orthogonal to the
  // upload/moderation lifecycle — an APPROVED object can be attached or
  // orphaned, and orphan-GC must never rewind a moderation verdict.
  attachedToPost Boolean   @default(false) @map("attached_to_post") // Whether media is attached to a post
  orphanedAt     DateTime? @map("orphaned_at") // When media was marked as orphaned
  lastAccessedAt DateTime  @default(now()) @map("last_accessed_at") // Last time media was accessed

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  posts          PostMedia[] // Many-to-many with posts
  moderationJobs MediaModerationJob[] // P0b: per-track moderation job records

  // AR10 prune: dropped @@index([tenantId, contentHash]) (exact duplicate of
  // the @@unique above — the serve path uses the unique's index), the boolean
  // flag indexes ([hidden, deletedAt], [metadataVisible], [locationVisible] —
  // flags are checked per-row after a tenant/hash lookup, never scanned), the
  // display-only [dateTaken], and the pruned reconciliation-column indexes.
  @@unique([tenantId, contentHash]) // Within-tenant dedup + the serve-path lookup index
  @@index([lifecycle]) // Gate + queue queries (moderation queue, stale-reap scope)
  @@index([createdAt]) // For chronological sorting + stale-reap cutoff
  @@index([uploadedBy]) // GDPR erasure: deleteMany({ where: { uploadedBy } })
  @@index([attachedToPost, createdAt]) // For orphaned media queries
  @@index([orphanedAt]) // For cleanup job queries
  @@map("media_files")
}

// Upload session. Two kinds share this model (discriminated by `kind`):
//
//  - "legacy"    — the original optimistic image-upload session: tracks the
//    mediaIds uploaded through the proxied POST /api/media path.
//    status: 'active' | 'completed' | 'abandoned'.
//
//  - "presigned" — T14 direct-to-S3 upload session (video; images may also
//    use it later). One session == one object == one MediaFile row. The
//    session id doubles as MediaFile.uploadId and as the object-key segment
//    (`pending/{tenantId}/{sessionId}` — cuid, satisfies UPLOAD_ID_RE), so
//    the S3 OBJECT_CREATED trigger and the completion call converge on the
//    same row. status: 'awaiting-upload' | 'uploaded' | 'abandoned' |
//    'expired'. The presigned columns below are null on legacy rows.
model UploadSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String   @default("legacy") // 'legacy' | 'presigned'
  mediaIds  String[] @map("media_ids") // Legacy: array of uploaded media IDs
  status    String   @default("active") // See kind-specific vocabularies above
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  // ── Presigned-kind columns (null on legacy rows) ──
  // Tenant that scopes the staged object (the key prefix is derived from it).
  tenantId         String?   @map("tenant_id")
  // The single MediaFile row this session uploads into (also reachable via
  // MediaFile.uploadId == this.id; denormalized for direct lookup).
  mediaId          String?   @map("media_id")
  // The exact staging object key the presigned grant is confined to:
  // pending/{tenantId}/{id}. Persisted so completion/abandon never re-derive.
  objectKey        String?   @map("object_key")
  // Client-declared upload metadata, validated at session creation.
  declaredMimeType String?   @map("declared_mime_type")
  declaredBytes    Int?      @map("declared_bytes")
  // When the completion call confirmed the bytes.
  uploadedAt       DateTime? @map("uploaded_at")

  @@index([userId, status])
  @@index([expiresAt])
  @@index([mediaId])
  @@map("upload_sessions")
}

// ============================================================================
// P0b — Moderation job tracking
// ============================================================================

// Discriminator for the two parallel moderation tracks.
// VISUAL — frame/thumbnail-level visual content analysis.
// AUDIO  — speech-to-text + audio content analysis.
enum ModerationTrack {
  VISUAL
  AUDIO
}

// One row per (media, track) moderation job submitted to an external provider.
// decision is String (not an enum) so the schema stays decoupled from
// ModerationDecision evolution; app code validates the value on read.
// thresholdSnapshot captures the operative thresholds at job-submission time
// so historical decisions remain auditable after a threshold change.
model MediaModerationJob {
  id                String          @id @default(cuid())
  mediaId           String          @map("media_id")
  media             MediaFile       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  track             ModerationTrack
  // jobId: the external provider's job identifier (unique per provider call).
  jobId             String          @unique @map("job_id")
  // decision: resolved ModerationDecision value, or null while the job is in flight.
  decision          String?
  // thresholdSnapshot: a copy of env.media.thresholds at submission time (JSON).
  thresholdSnapshot Json            @map("threshold_snapshot")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  // AR10 prune: dropped [jobId] (duplicate of @unique).
  @@index([mediaId])
  @@map("media_moderation_jobs")
}

// Deduplication table for SQS moderation-result messages (exactly-once delivery).
// A row is inserted (with ON CONFLICT DO NOTHING / unique-constraint) before
// processing; duplicate deliveries of the same message find the row present and
// are skipped. Rows may be pruned after a retention window by a cron worker.
model ProcessedModerationMessage {
  id               String   @id @default(cuid())
  messageDedupeKey String   @unique @map("message_dedupe_key")
  processedAt      DateTime @default(now()) @map("processed_at")

  @@map("processed_moderation_messages")
}

// Post media
model PostMedia {
  id       String  @id @default(cuid())
  // Multi-tenancy — denormalized from the owning post; same scope.
  tenantId String  @map("tenant_id")
  postId   String  @map("post_id")
  mediaId  String  @map("media_id")
  alt      String?
  order    Int     @default(0)

  post   Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  media  MediaFile @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [postId] (prefix of the unique).
  @@unique([postId, mediaId])
  @@index([tenantId])
  @@index([mediaId])
  @@map("post_media")
}

// Post sentiment reactions
model PostSentiment {
  id        String   @id @default(cuid())
  // Multi-tenancy — denormalized from the owning post; same scope.
  tenantId  String   @map("tenant_id")
  postId    String   @map("post_id")
  postUri   String?  @map("post_uri")
  authorId  String   @map("author_id")
  sentiment String
  createdAt DateTime @default(now()) @map("created_at")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [postId] / [postUri] (prefixes of the composite
  // uniques above), [postId, sentiment] and the summary index (both are
  // leading prefixes of idx_post_sentiment_pagination — a b-tree on
  // (a, b, c DESC, d DESC) serves equality on (a) / (a, b) and the windowed
  // summary scan). 4 indexes carry every read path.
  @@unique([postId, authorId])
  @@unique([postUri, authorId])
  @@index([authorId])
  @@index([postId, createdAt]) // For time-based sentiment queries
  @@index([postId, sentiment, createdAt(sort: Desc), id(sort: Desc)], name: "idx_post_sentiment_pagination") // Aggregation, summary + cursor pagination
  @@index([tenantId])
  @@map("post_sentiments")
}

// Post comments
model PostComment {
  id                String   @id @default(cuid())
  // Multi-tenancy (v0.7) — denormalized from the parent post; same scope.
  tenantId          String   @map("tenant_id")
  postId            String   @map("post_id")
  postUri           String?  @map("post_uri")
  authorId          String   @map("author_id")
  text              String   @db.Text
  rootUri           String?  @map("root_uri")
  replyToUri        String?  @map("reply_to_uri")
  hiddenByPostOwner Boolean  @default(false) @map("hidden_by_post_owner")
  createdAt         DateTime @default(now()) @map("created_at")

  // Edit tracking
  editedAt     DateTime? @map("edited_at") // When last edited
  originalText String?   @map("original_text") @db.Text // Preserve original on first edit

  // Soft delete tracking
  deletedAt DateTime? @map("deleted_at") // When deleted (soft delete)
  deletedBy String?   @map("deleted_by") // User ID who deleted (author or post owner)

  // Link security fields
  hasBlockedLinks Boolean @default(false) @map("has_blocked_links")

  // AR10 prune: dormant classification columns removed (see Post model note).

  post       Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  media      PostCommentMedia[]
  sentiments CommentSentiment[]
  linkChecks LinkCheck[]

  // AR10 prune: dropped [hiddenByPostOwner] and [deletedAt] (low-cardinality
  // flags always combined with a selective postId predicate), [rootUri]
  // (prefix of [rootUri, createdAt]), and the dormant-classification indexes.
  @@index([tenantId])
  @@index([postId, createdAt])
  @@index([postUri, createdAt])
  @@index([authorId])
  // Threading indexes
  @@index([replyToUri]) // Find direct replies to a comment
  @@index([rootUri, createdAt]) // Thread comments ordered by time (covers bare rootUri lookups)
  @@index([postId, rootUri]) // Thread comments within a specific post
  @@map("post_comments")
}

// Comment media (placeholder - MediaFile model to be defined separately)
model PostCommentMedia {
  id        String  @id @default(cuid())
  commentId String  @map("comment_id")
  mediaId   String  @map("media_id")
  alt       String?
  order     Int     @default(0)

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [commentId] (prefix of the unique).
  @@unique([commentId, mediaId])
  @@index([mediaId])
  @@map("post_comment_media")
}

// Comment sentiment reactions
model CommentSentiment {
  id         String   @id @default(cuid())
  commentId  String   @map("comment_id")
  commentUri String?  @map("comment_uri")
  authorId   String   @map("author_id")
  sentiment  String
  createdAt  DateTime @default(now()) @map("created_at")

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [commentId] / [commentUri] (prefixes of the
  // composite uniques above).
  @@unique([commentId, authorId])
  @@unique([commentUri, authorId])
  @@index([authorId])
  @@index([commentId, sentiment]) // For faster sentiment count aggregation (groupBy)
  @@index([commentId, createdAt]) // For time-based sentiment queries
  @@map("comment_sentiments")
}

// Post-Subject junction — which entities a post is about (primary content model)
model PostSubject {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  entityId  String   @map("entity_id")
  isPrimary Boolean  @default(false) @map("is_primary") // The "main" entity when multiple are featured
  createdAt DateTime @default(now()) @map("created_at")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [postId] (prefix of the unique) and [entityId]
  // (prefix of [entityId, createdAt]).
  @@unique([postId, entityId])
  @@index([entityId, createdAt]) // Core query: "posts about this entity, newest first"
  @@map("post_subjects")
}

// Security Events for SSO monitoring and compliance.
// In v0.7, this also serves as the audit-log substrate (T7 wires admin actions here).
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String // sso_login, sso_failed, sso_config_error, rate_limit_exceeded, suspicious_activity, unauthorized_access, tenant_*, member_*, idp_*, etc.
  severity  String // low, medium, high, critical
  userId    String?
  // Tenancy scope (v0.7) — replaces the old `partnerId` field.
  // Nullable because some events (system-level) have no tenant context.
  tenantId  String?  @map("tenant_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  details   String // JSON string
  timestamp DateTime @default(now())

  // Retention bound — NON-NULLABLE (Surveillance-hardening Phase 0, P1). A NULL
  // row escapes the hourly-cron pruning forever: exactly the unbounded client-
  // metadata log the threat model forbids (07-data-minimization.md), and P3
  // writes IP/UA `signup` rows into this table. The hourly cron deletes events
  // where retention_until < NOW(). Retention by severity: critical=365d,
  // high=90d, medium=30d, low=7d (see security-monitor.calculateRetentionUntil).
  retentionUntil DateTime @map("retention_until")

  user User? @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([severity])
  @@index([timestamp])
  @@index([userId])
  @@index([tenantId])
  @@index([ipAddress])
  @@index([retentionUntil]) // Index for efficient cleanup job queries
  @@map("security_events")
}

// AuditEvent model (phase 1.C.2)
//
// Backing store for `@de-otio/saas-foundation/audit` via
// `PostgresAuditStore` (the `auditEvent.create` shape). Column names
// and nullability mirror foundation's `PrismaAuditClient` contract
// EXACTLY — see foundation `src/audit/prisma.ts`. The frozen
// `AuditEvent` type owns this shape; changes require the frozen-type
// RFC process.
//
// Append-only posture: foundation's PostgresAuditStore performs INSERT
// only. A separate sweeper deletes rows where `retention_until < now()`.
// `id` is a foundation-minted ulid (NOT a Prisma cuid default).
model AuditEvent {
  id             String   @id
  timestamp      DateTime
  tenantId       String?  @map("tenant_id")
  actorKind      String   @map("actor_kind")
  actorId        String   @map("actor_id")
  action         String
  resourceKind   String?  @map("resource_kind")
  resourceId     String?  @map("resource_id")
  outcome        String
  failureReason  String?  @map("failure_reason")
  severity       String
  requestId      String?  @map("request_id")
  traceId        String?  @map("trace_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadata       Json?
  retentionUntil DateTime @map("retention_until")

  @@index([tenantId])
  @@index([timestamp])
  @@index([action])
  @@index([retentionUntil]) // sweeper: DELETE WHERE retention_until < now()
  @@map("audit_event")
}

// Feature Toggle model — global or per-tenant (Surveillance-hardening Phase 0,
// E4). tenantId NULL = global row; a non-NULL row overrides the global for that
// tenant. Resolution (tenant → global → coded default) is P5.
//
// Uniqueness: `@@unique([key, tenantId])` lets each tenant hold one row per key.
// Postgres treats NULLs as DISTINCT, so that constraint alone would permit
// DUPLICATE global rows for the same key — the migration adds a PARTIAL unique
// index `feature_toggles_key_global ON (key) WHERE tenant_id IS NULL` to forbid
// it. That partial index is NOT expressible in schema.prisma; it lives only in
// the migration SQL. Do not let a later `prisma migrate dev` treat it as drift.
model FeatureToggle {
  id          String   @id @default(cuid())
  key         String // e.g., "global_public_posting_enabled"
  enabled     Boolean  @default(false)
  description String? // Human-readable description
  tenantId    String?  @map("tenant_id") // NULL = global; non-NULL = per-tenant override
  changedBy   String?  @map("changed_by") // Email of user who last changed it
  changedAt   DateTime @default(now()) @updatedAt @map("last_changed")
  createdAt   DateTime @default(now()) @map("created_at")

  // AR10 prune: dropped [key] (prefix of the composite unique) and the
  // boolean [enabled].
  @@unique([key, tenantId])
  @@index([tenantId])
  @@map("feature_toggles")
}

// Invitation model for user-to-user invitations
model Invitation {
  id        String    @id @default(cuid())
  code      String    @unique // Unique invitation code (e.g., "ABC123XYZ")
  createdBy String    @map("created_by") // User ID who created the invitation
  email     String? // Optional: restrict invitation to specific email
  used      Boolean   @default(false) // Whether invitation has been used
  usedBy    String?   @map("used_by") // User ID who used the invitation
  usedAt    DateTime? @map("used_at") // When invitation was used
  scannedAt DateTime? @map("scanned_at") // When invitation code was first scanned/claimed
  scannedBy String?   @map("scanned_by") // Temporary identifier for who scanned it (session ID or similar)
  expiresAt DateTime? @map("expires_at") // Optional expiration date
  createdAt DateTime  @default(now()) @map("created_at")

  creator User? @relation("CreatedInvitations", fields: [createdBy], references: [id])
  user    User? @relation("UsedInvitations", fields: [usedBy], references: [id])

  // Phase 0 (E2): accounts that recorded this invitation as their signup origin.
  signupUsers User[] @relation("SignupInvitation")

  // AR10 prune: dropped [code] (duplicate of @unique), [createdBy] (prefix of
  // [createdBy, createdAt]) and the boolean [used].
  @@index([createdBy, createdAt]) // Composite index for efficient listing queries (filter by createdBy, order by createdAt)
  @@index([usedBy])
  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

// ============================================================================
// Taxonomy System (Phase 1: Core Taxonomy Foundation)
// ============================================================================

// Taxonomy dimension (top-level category)
model TaxonomyDimension {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id") // REQUIRED - Tenant-specific taxonomy
  code        String // e.g., "behavior", "context"
  displayName String   @map("display_name")
  description String?  @db.Text
  order       Int      @default(0) // For UI ordering
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categories TaxonomyCategory[]

  // AR10 prune: dropped [tenantId] and [tenantId, code] (prefix/duplicate of
  // the composite unique).
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("taxonomy_dimensions")
}

// Taxonomy category (second-level, e.g., "training" under "behavior")
model TaxonomyCategory {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id") // REQUIRED - Tenant-specific taxonomy
  dimensionId String   @map("dimension_id")
  code        String // e.g., "training", "issues"
  displayName String   @map("display_name")
  description String?  @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dimension TaxonomyDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  taxons    TaxonomyTaxon[]

  // AR10 prune: dropped [tenantId] and [tenantId, dimensionId] (prefixes of
  // the composite unique).
  @@unique([tenantId, dimensionId, code])
  @@index([tenantId, isActive])
  @@map("taxonomy_categories")
}

// Taxonomy taxon (specific term, e.g., "recall" under "behavior:training")
model TaxonomyTaxon {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id") // REQUIRED - Tenant-specific taxonomy
  categoryId  String  @map("category_id")
  taxonId     String // Full ID: "behavior:training:recall"
  displayName String  @map("display_name")
  description String? @db.Text
  order       Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  // Synonyms and user terms for search matching
  synonyms  Json? // Array of alternative terms: ["obedience", "foundation-training"]
  userTerms Json? // Array of user search terms: ["sit-stay-come", "basic-commands"]

  // Hierarchical support
  parentTaxonId String?         @map("parent_taxon_id")
  parentTaxon   TaxonomyTaxon?  @relation("TaxonHierarchy", fields: [parentTaxonId], references: [id])
  childTaxons   TaxonomyTaxon[] @relation("TaxonHierarchy")

  // Translations (stored as JSON for now, can be normalized later)
  translations Json? // { "en": {...}, "de": {...}, "fr": {...} }

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category    TaxonomyCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        PostTaxonomyTag[]
  entityTags  EntityTaxonomyTag[]
  productTags ProductTaxonomyTag[]

  // AR10 prune: dropped [tenantId] and [tenantId, taxonId] (prefix/duplicate
  // of the composite unique).
  @@unique([tenantId, taxonId])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive])
  @@index([parentTaxonId])
  @@map("taxonomy_taxons")
}

// Junction table for post-taxonomy tag relationships
model PostTaxonomyTag {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  taxonId   String   @map("taxon_id")
  addedBy   String   @map("added_by") // User ID
  createdAt DateTime @default(now()) @map("created_at")

  post  Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  taxon TaxonomyTaxon @relation(fields: [taxonId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [postId] (prefix of the unique) and [addedBy]
  // (never queried).
  @@unique([postId, taxonId])
  @@index([taxonId])
  @@map("post_taxonomy_tags")
}

// Junction table for entity-taxonomy tag relationships
model EntityTaxonomyTag {
  id        String   @id @default(cuid())
  entityId  String   @map("entity_id")
  taxonId   String   @map("taxon_id")
  createdAt DateTime @default(now()) @map("created_at")

  entity Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  taxon  TaxonomyTaxon @relation(fields: [taxonId], references: [id], onDelete: Cascade)

  // AR10 prune: dropped [entityId] (prefix of the unique).
  @@unique([entityId, taxonId])
  @@index([taxonId])
  @@map("entity_taxonomy_tags")
}

// Junction table for product-taxonomy tag relationships
// Tags a tenant's Shopify product (an external `productId` string — there is
// no local `Product` table) with internal taxonomy taxa. This is tenant-owned
// data, so it carries its own tenant_id for direct RLS. (Without it,
// `findMany({ where: { productId } })` leaks tags across tenants that happen to
// reference the same Shopify product id.)
model ProductTaxonomyTag {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  productId String   @map("product_id")
  taxonId   String   @map("taxon_id")
  createdAt DateTime @default(now()) @map("created_at")

  taxon  TaxonomyTaxon @relation(fields: [taxonId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, taxonId])
  @@index([tenantId])
  @@index([productId])
  @@index([taxonId])
  @@map("product_taxonomy_tags")
}

