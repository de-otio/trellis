# OpenTofu local state (this spike uses local state deliberately — see
# infra/versions.tf for why the real WS-0 path differs).
infra/*.tfstate
infra/*.tfstate.*
infra/.terraform/
infra/*.tfvars
infra/*.tfvars.json
infra/crash.log
infra/crash.*.log

# tofu output -json dump consumed by the harness — contains sensitive
# outputs (DB password, SQS credentials) so it must never be committed.
infra/outputs.json

# Harness
harness/node_modules/
harness/.env
harness/*.log

# Local credential wrapper — sets non-secret IDs (org/project/access key) and
# pulls SCW_SECRET_KEY from the macOS keychain at runtime. No secret in the
# file, but keep the org/project/access identifiers out of git anyway.
run.sh
